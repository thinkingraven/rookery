{
  "name": "@thinkingraven/rookery",
  "version": "0.1.0",
  "description": "Scan repos for AI agent skills, rules and workflows (Claude Code, Codex, Cursor, Copilot, Gemini): inventory, duplicates and security findings.",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "agent-skills",
    "skill",
    "mcp",
    "security",
    "ai-agents",
    "governance"
  ],
  "license": "MIT",
  "author": "Thinking Raven <hello@thinkingraven.com>",
  "homepage": "https://github.com/thinkingraven/rookery#readme",
  "type": "module",
  "bin": {
    "rookery": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "scan": "node dist/src/cli.js scan",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinkingraven/rookery.git"
  },
  "bugs": {
    "url": "https://github.com/thinkingraven/rookery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
