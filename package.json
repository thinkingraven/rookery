{
  "name": "@thinkingraven/rookery",
  "version": "0.8.0",
  "description": "Find every AI agent skill in your repos, spot the duplicates teams keep rebuilding, and catch the risky ones. Claude Code, Codex, Cursor, Copilot, Gemini, Windsurf and MCP.",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "cursor",
    "github-copilot",
    "gemini-cli",
    "windsurf",
    "agent-skills",
    "skills",
    "mcp",
    "ai-agents",
    "prompt-injection",
    "security",
    "static-analysis",
    "devsecops",
    "governance",
    "cli"
  ],
  "license": "MIT",
  "author": "Thinking Raven <hello@thinkingraven.com>",
  "homepage": "https://github.com/thinkingraven/rookery#readme",
  "type": "module",
  "bin": {
    "rookery": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "scan": "node dist/src/cli.js scan",
    "prepublishOnly": "npm test",
    "docs": "npm run build && node scripts/gen-rules-doc.mjs",
    "docs:capabilities": "node scripts/gen-capabilities-doc.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinkingraven/rookery.git"
  },
  "bugs": {
    "url": "https://github.com/thinkingraven/rookery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
